generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Enum for user roles
enum Role {
  ADMIN
  USER
}

enum AssuranceCatalogType {
  CAR
  FARMER
}

enum GuaranteeInputType {
  CHECKBOX
  SELECTGROUP
}

enum PartnerType {
  TOWING
  MECHANIC
  EXPERT
  BODY_SHOP
  INSURANCE
  SPARE_PARTS
  OIL_DISTRIBUTOR
  CONTROL_CENTER
  TIRE_CENTER
  AUTO_ELECTRICIAN
  LEGAL
}

// User model
model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  password         String?
  name             String?
  dateOfBirth      DateTime?
  gender           String?
  phone            String?
  profession       String?
  wilaya           String?
  region           String?
  address          String?
  licenseNumber    String?
  licenseType      String?
  licenseIssueDate DateTime?
  secondaryDrivers String[]  @default([])
  role             Role      @default(USER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum ContractStatus {
  EN_ATTENTE
  APPROUVE
  REFUSE
  EXPIRE
}

enum AccidentStatus {
  EN_ATTENTE
  EN_REVUE
  ACCEPTEE
  REFUSEE
}

model Contract {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  contractNumber       String         @unique
  userId               String         @db.ObjectId
  status               ContractStatus @default(EN_ATTENTE)
  assuranceType        String

  // Vehicle info
  brand                String
  model                String
  version              String
  energy               String
  seats                String
  parking              String
  registration         String
  chassisNumber        String
  firstRegistrationDate String
  marketValue          String
  usage                String
  circulationZone      String
  insuredCapital       String
  mileage              String
  estimatedKmPerYear   String
  horsepower           String

  // Pricing
  basePrice            Int
  optionsTotal         Int
  totalCost            Int

  // Selected guarantees stored as JSON
  selectedGuarantees   Json

  // Payment
  paymentMethod        String

  // Photos (Cloudinary URLs)
  vehiclePhotoUrls     String[]  @default([])
  documentUrls         Json?

  // Admin
  adminNotes           String[]  @default([])

  accidents            AccidentDeclaration[]

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model AccidentDeclaration {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  caseNumber    String         @unique
  contractId    String         @db.ObjectId
  userId        String         @db.ObjectId
  status        AccidentStatus @default(EN_ATTENTE)

  // Key fields for admin list view
  accidentDate  String
  accidentTime  String
  location      String
  wilaya        String
  weather       String
  description   String
  vehiclePlate  String

  // Full form data as JSON
  formData      Json

  // Photos (Cloudinary URLs)
  photoUrls     String[]  @default([])
  sketchUrls    String[]  @default([])

  internalNotes String[]  @default([])

  contract      Contract  @relation(fields: [contractId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([contractId])
  @@index([status])
}

model GuaranteeGroup {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  assuranceType AssuranceCatalogType
  key           String
  title         String
  description   String?
  inputType     GuaranteeInputType
  mandatory     Boolean              @default(false)
  sortOrder     Int                  @default(0)
  options       GuaranteeOption[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([assuranceType, key])
  @@index([assuranceType, sortOrder])
}

model GuaranteeOption {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  groupId   String         @db.ObjectId
  key       String
  label     String
  price     Int            @default(0)
  sortOrder Int            @default(0)
  group     GuaranteeGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, key])
  @@index([groupId, sortOrder])
}

model Partner {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        PartnerType
  wilaya      String
  city        String?
  address     String
  phone       String
  rating      Float       @default(0)
  available   Boolean     @default(true)
  hours       String
  eta         String?
  description String?
  logoUrl     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type])
  @@index([wilaya])
  @@index([type, wilaya])
}
