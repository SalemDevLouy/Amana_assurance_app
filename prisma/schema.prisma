generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Enum for user roles
enum Role {
  ADMIN
  USER
}

enum AssuranceCatalogType {
  CAR
  FARMER
}

enum GuaranteeInputType {
  CHECKBOX
  SELECTGROUP
}

// User model
model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  password         String?
  name             String?
  dateOfBirth      DateTime?
  gender           String?
  phone            String?
  profession       String?
  wilaya           String?
  region           String?
  address          String?
  licenseNumber    String?
  licenseType      String?
  licenseIssueDate DateTime?
  secondaryDrivers String[]  @default([])
  role             Role      @default(USER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model GuaranteeGroup {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  assuranceType AssuranceCatalogType
  key           String
  title         String
  description   String?
  inputType     GuaranteeInputType
  mandatory     Boolean              @default(false)
  sortOrder     Int                  @default(0)
  options       GuaranteeOption[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([assuranceType, key])
  @@index([assuranceType, sortOrder])
}

model GuaranteeOption {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  groupId   String         @db.ObjectId
  key       String
  label     String
  price     Int            @default(0)
  sortOrder Int            @default(0)
  group     GuaranteeGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, key])
  @@index([groupId, sortOrder])
}
